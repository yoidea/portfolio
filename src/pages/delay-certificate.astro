---
import BaseLayout from "../layouts/BaseLayout.astro";
import certificateLogo from "../images/logo.png";
---

<BaseLayout title="遅延証明書">
  <section class="section certificate-shell">
    <div class="container">
      <p id="certificate-loading">証明書を読み込んでいます。</p>
      <div id="certificate-error" class="error" hidden>
        <p></p>
        <a href="/videos#delay">遅延証明書一覧へ戻る</a>
      </div>
      <section id="certificate" class="delay-certificate" hidden>
        <div class="certificate-topline">
          <img class="certificate-logo" src={certificateLogo.src} alt="ラムダ技術部" />
        </div>
        <h1>遅延証明書</h1>
        <p class="certificate-lead">
          YouTube動画投稿が以下のとおり遅れたことを証明します。
          <br />
          お急ぎのところ、ご迷惑をおかけしました。
        </p>
        <div class="summary-panel">
          <div>
            <span>遅延時間</span>
            <strong data-delay></strong>
          </div>
          <div>
            <span>状態</span>
            <strong data-status></strong>
          </div>
        </div>
        <table class="certificate-table">
          <tbody>
            <tr>
              <th>予定投稿日時</th>
              <td data-scheduled></td>
            </tr>
            <tr>
              <th>公開日時</th>
              <td data-published></td>
            </tr>
            <tr>
              <th>対象動画</th>
              <td data-video></td>
            </tr>
          </tbody>
        </table>
        <div class="issuer">
          <p data-checked></p>
          <p>ラムダ技術部</p>
        </div>
        <section class="certificate-notes">
          <h2>ご利用上の注意</h2>
          <ol>
            <li>本証明書は、ラムダ技術部の動画更新が予定時刻より遅延したことを示すものです。</li>
            <li>本証明書の遅延時間は、毎週土曜日18時を基準とした自動計算値です。</li>
            <li>本証明書は、動画更新の遅延によって生じた損害等を補償するものではありません。</li>
          </ol>
        </section>
        <div class="print-actions print-hidden">
          <button class="button" type="button" data-print>印刷 / PDF保存</button>
        </div>
      </section>
    </div>
  </section>

  <script>
    const API_PATH = "/.netlify/functions/delay-certificates";
    const params = new URLSearchParams(window.location.search);
    const id = params.get("id");
    const mockMode = params.get("mock");
    const loading = document.querySelector("#certificate-loading");
    const errorBox = document.querySelector("#certificate-error");
    const errorText = errorBox.querySelector("p");
    const certificateEl = document.querySelector("#certificate");

    function buildMock(mode, requestedId) {
      const now = new Date();
      const scheduled = new Date(now);
      scheduled.setHours(18, 0, 0, 0);
      const day = scheduled.getDay();
      scheduled.setDate(scheduled.getDate() - ((day - 6 + 7) % 7));
      const published = new Date(scheduled.getTime() + 72 * 60000);

      const publishedRecord = {
        id: "mock-published",
        scheduledAt: scheduled.toISOString(),
        checkedAt: now.toISOString(),
        status: "published",
        publishedAt: published.toISOString(),
        delayMinutes: 72,
        videoTitle: "モック動画: 投稿済み",
        videoUrl: "https://www.youtube.com/channel/UC8g17oXkRt8buwQL8GU-NSw",
      };
      const delayedRecord = {
        id: "mock-delayed",
        scheduledAt: scheduled.toISOString(),
        checkedAt: now.toISOString(),
        status: "delayed",
        publishedAt: null,
        delayMinutes: Math.max(10, Math.floor((now - scheduled) / 60000)),
        videoTitle: null,
        videoUrl: null,
      };

      if (mode === "published") return publishedRecord;
      if (mode === "delayed" || mode === "true") return delayedRecord;
      if (requestedId === "mock-published") return publishedRecord;
      if (requestedId === "mock-delayed") return delayedRecord;
      return null;
    }

    function formatDateTime(value) {
      if (!value) return "";
      return new Intl.DateTimeFormat("ja-JP", {
        year: "numeric",
        month: "long",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        timeZone: "Asia/Tokyo",
      }).format(new Date(value));
    }

    function formatDate(value) {
      if (!value) return "";
      return new Intl.DateTimeFormat("ja-JP", {
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "Asia/Tokyo",
      }).format(new Date(value));
    }

    function formatMinutes(minutes) {
      const safeMinutes = Number(minutes) || 0;
      const days = Math.floor(safeMinutes / 1440);
      const hours = Math.floor((safeMinutes % 1440) / 60);
      const restMinutes = safeMinutes % 60;
      if (days > 0) return `${days}日 ${hours}時間 ${restMinutes}分 (${safeMinutes}分)`;
      if (hours > 0) return `${hours}時間 ${restMinutes}分 (${safeMinutes}分)`;
      return `${safeMinutes}分`;
    }

    function effectiveDelayMinutes(certificate) {
      if (certificate && certificate.status === "delayed" && certificate.scheduledAt) {
        return Math.max(0, Math.floor((Date.now() - new Date(certificate.scheduledAt).getTime()) / 60000));
      }
      return certificate ? certificate.delayMinutes : 0;
    }

    function statusLabel(status) {
      return {
        delayed: "遅延中",
        published: "公開済み",
        "no-delay": "遅延なし",
        pending: "確認中",
      }[status] || status || "";
    }

    function render(certificate) {
      const title = certificate.videoTitle || "未公開";
      certificateEl.querySelector("[data-delay]").textContent = formatMinutes(effectiveDelayMinutes(certificate));
      certificateEl.querySelector("[data-status]").textContent = statusLabel(certificate.status);
      certificateEl.querySelector("[data-scheduled]").textContent = formatDateTime(certificate.scheduledAt);
      certificateEl.querySelector("[data-published]").textContent = certificate.publishedAt ? formatDateTime(certificate.publishedAt) : "未公開";
      certificateEl.querySelector("[data-checked]").textContent = formatDate(certificate.checkedAt);
      certificateEl.querySelector("[data-video]").innerHTML = certificate.videoUrl
        ? `<a href="${certificate.videoUrl}" target="_blank" rel="noopener noreferrer">${title}</a>`
        : title;
      loading.hidden = true;
      certificateEl.hidden = false;
    }

    async function init() {
      try {
        const mock = buildMock(mockMode, id);
        if (mock) {
          render(mock);
          return;
        }
        if (!id) throw new Error("証明書IDが指定されていません。");
        const data = await fetch(`${API_PATH}?id=${encodeURIComponent(id)}`).then(async (response) => {
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || "証明書を取得できませんでした。");
          return data;
        });
        render(data.certificate);
      } catch (error) {
        loading.hidden = true;
        errorText.textContent = `証明書を取得できませんでした: ${error.message}`;
        errorBox.hidden = false;
      }
    }

    document.querySelector("[data-print]").addEventListener("click", () => window.print());
    init();
  </script>
</BaseLayout>

<style>
  .certificate-shell {
    background: #455a64;
  }

  .error {
    background: #fff8e1;
    border-left: 0.35rem solid var(--site-accent-2);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
  }

  .delay-certificate {
    background: #fff;
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.25);
    color: #263238;
    margin: 0 auto;
    max-width: 820px;
    min-height: 1060px;
    padding: 3.5rem 4rem 3rem;
  }

  .certificate-topline {
    border-bottom: 1px solid #cfd8dc;
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
  }

  .certificate-logo {
    max-height: 4.5rem;
    width: 11rem;
  }

  h1 {
    border-bottom: 3px solid #263238;
    border-top: 3px solid #263238;
    font-size: clamp(2.1rem, 6vw, 2.8rem);
    letter-spacing: 0;
    margin: 0 auto 2.25rem;
    max-width: 17rem;
    padding: 0.7rem 0;
    text-align: center;
  }

  .certificate-lead {
    font-size: 1.12rem;
    line-height: 1.9;
    margin: 0 auto 2rem;
    max-width: 34rem;
    text-align: center;
  }

  .summary-panel {
    border: 2px solid #263238;
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-bottom: 2rem;
  }

  .summary-panel > div {
    display: flex;
    justify-content: space-between;
    min-height: 5rem;
    padding: 1rem 1.25rem;
  }

  .summary-panel > div + div {
    border-left: 2px solid #263238;
  }

  .summary-panel span {
    color: #546e7a;
    font-weight: 800;
  }

  .summary-panel strong {
    font-size: 1.35rem;
  }

  .certificate-table {
    margin-bottom: 1.5rem;
    width: 100%;
  }

  .certificate-table th,
  .certificate-table td {
    border: 1px solid #b0bec5;
    padding: 0.9rem 1rem;
    vertical-align: top;
  }

  .certificate-table th {
    background: #eceff1;
    width: 11rem;
  }

  .issuer {
    margin: 2rem 0 3rem;
    text-align: right;
  }

  .issuer p {
    margin: 0.25rem 0;
  }

  .certificate-notes {
    border-top: 1px solid #cfd8dc;
    color: #455a64;
    font-size: 0.88rem;
    padding-top: 1.25rem;
  }

  .certificate-notes h2 {
    color: #263238;
    font-size: 1rem;
    margin: 0 0 0.6rem;
  }

  .print-actions {
    margin-top: 2rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .delay-certificate {
      min-height: auto;
      padding: 2rem 1.25rem;
    }

    .summary-panel {
      grid-template-columns: 1fr;
    }

    .summary-panel > div {
      flex-direction: column;
      gap: 0.35rem;
    }

    .summary-panel > div + div {
      border-left: 0;
      border-top: 2px solid #263238;
    }

    .certificate-table th,
    .certificate-table td {
      display: block;
      width: auto;
    }
  }

  @media print {
    .certificate-shell {
      background: #fff !important;
      padding: 0 !important;
    }

    .delay-certificate {
      box-shadow: none;
      margin: 0;
      max-width: none;
      min-height: auto;
      padding: 0;
    }
  }
</style>
