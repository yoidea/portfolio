---
import BaseLayout from "../layouts/BaseLayout.astro";

const links = [
  { href: "https://www.youtube.com/channel/UC8g17oXkRt8buwQL8GU-NSw", label: "YouTube" },
  { href: "https://twitter.com/yoidea", label: "Twitter" },
  { href: "https://www.instagram.com/yoidea", label: "Instagram" },
  { href: "/contact", label: "お問い合わせ", internal: true },
];
---

<BaseLayout title="ラムダ技術部">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">YouTube / Engineering / Media</p>
        <h1>ラムダ技術部</h1>
        <p class="lead">
          技術系の真面目な動画や不真面目な動画を投稿しているYouTubeチャンネルです。
          プログラミング、電子工学、数学などに興味を持つきっかけになれると嬉しいです。
        </p>
        <div class="link-row" aria-label="主要リンク">
          {links.map((link) => (
            <a
              class={link.internal ? "button secondary" : "button"}
              href={link.href}
              target={link.internal ? undefined : "_blank"}
              rel={link.internal ? undefined : "noopener noreferrer"}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
      <aside class="contact-card card" aria-label="連絡先概要">
        <h2>Official Contact</h2>
        <p>
          取材、コンテンツ利用、制作相談などのお問い合わせはフォームからお願いします。
        </p>
        <a class="button" href="/contact">連絡先を見る</a>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container feature-grid">
      <a class="feature-card card" href="/videos">
        <span>Videos</span>
        <h2>動画と遅延証明書</h2>
        <p>YouTubeチャンネル紹介、現在の遅延状況、発行済み証明書を掲載しています。</p>
      </a>
      <a class="feature-card card" href="/guidelines">
        <span>Guidelines</span>
        <h2>コンテンツ利用</h2>
        <p>教育目的やメディア紹介など、動画等コンテンツの利用条件をまとめています。</p>
      </a>
      <a class="feature-card card" href="/works">
        <span>Works</span>
        <h2>関連作品</h2>
        <p>これまでに制作・参加したプロジェクトを掲載しています。</p>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background:
      radial-gradient(circle at top left, rgba(0, 188, 212, 0.18), transparent 36rem),
      linear-gradient(135deg, #f7f9fb 0%, #eef4f6 100%);
    min-height: calc(100svh - 4.5rem);
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .hero-grid {
    align-items: center;
    display: grid;
    gap: clamp(2rem, 6vw, 5rem);
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
  }

  .eyebrow {
    color: var(--site-accent);
    font-weight: 800;
    letter-spacing: 0.08em;
    margin: 0 0 1rem;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(3.5rem, 13vw, 9rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.95;
    margin: 0 0 1.5rem;
  }

  .hero-copy {
    max-width: 48rem;
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .contact-card {
    padding: clamp(1.5rem, 4vw, 2rem);
  }

  .contact-card h2 {
    font-size: 1.5rem;
    margin: 0 0 0.75rem;
  }

  .contact-card p {
    color: var(--site-muted);
    margin-bottom: 1.5rem;
  }

  .feature-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .feature-card {
    color: var(--site-ink);
    display: block;
    padding: 1.5rem;
    text-decoration: none;
  }

  .feature-card:hover {
    border-color: rgba(0, 150, 136, 0.45);
    color: var(--site-ink);
    transform: translateY(-2px);
  }

  .feature-card span {
    color: var(--site-accent);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .feature-card h2 {
    font-size: 1.35rem;
    margin: 0.4rem 0 0.5rem;
  }

  .feature-card p {
    color: var(--site-muted);
    margin: 0;
  }

  @media (max-width: 840px) {
    .hero-grid,
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
